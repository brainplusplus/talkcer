{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talkcer",
  "version": "0.1.0",
  "identifier": "dev.talkcer.desktop",
  "build": {
    "frontendDist": "../../apps/web/dist",
    "devUrl": "http://127.0.0.1:54001"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Talkcer",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Talkcer Overlay",
        "url": "/overlay-window",
        "width": 420,
        "height": 240,
        "x": 40,
        "y": 40,
        "resizable": true,
        "transparent": true,
        "alwaysOnTop": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
